# D:\agrodss\.env — 이 파일을 복사해 .env 로 저장한다(값은 .env 에만, git 에 올라가지 않는다)

# ② D-12 동기화 폴더 (권고 채택 2026-09-18: OneDrive 카메라 업로드). 여러 폴더는 ; 로 구분
AGRODSS_WATCH_DIRS=C:\Users\<이름>\OneDrive\사진\카메라 앨범

# ③ I-6 토양검정 — D:\vela\.env 에서 같은 이름의 값을 옮긴다(D-9 키 인용)
SOIL_API_KEY=
VWORLD_API_KEY=

# M-15 ⑥ 비료 처방(흙토람 FrtlzrUse · FrtlzrStdUse) — D:\vela\.env 의 같은 이름. 비면 DATA_GO_KR_API_KEY 로 대체
FERTILIZER_API_KEY=
FERTILIZER_STD_API_KEY=

# M-15 ② 기상 — D:\vela\.env 에서 같은 이름의 값을 옮긴다
KMA_API_HUB_KEY=
KMA_FORECAST_API_KEY=
DATA_GO_KR_API_KEY=

# M-15 ③ 병해충 예찰(NCPMS) — D:\vela\.env 에서 옮긴다
NCPMS_API_KEY=

# M-15 ④ 유기농업자재 공시 재수집 — 비면 DATA_GO_KR_API_KEY 로 대체
ORGANIC_MATERIAL_API_KEY=

# M-15 ⑤ PSIS 농약등록정보(관행 갈래) — psis.rda.go.kr 전용 활용신청 키. D:\vela\.env 의 같은 이름
PSIS_API_KEY=

# 내부 화면 포트(기본 8765)
# AGRODSS_FRONTEND_PORT=8765

# D-16 휴대폰 동기화(같은 Wi-Fi) — 발행자 결정 뒤에만 켠다. 둘 다 있어야 루프백 밖에 묶인다
# AGRODSS_BIND=0.0.0.0
# AGRODSS_LAN_TOKEN=(16자 이상 무작위)
